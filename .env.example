# BlackyAgent Configuration Template
# Get your free Gemini API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3-flash-preview,gemini-flash-latest,gemini-flash-lite-latest

# Voice Settings
BLACKY_VOICE=Samantha
BLACKY_SPEECH_RATE=195
BLACKY_VOICE_ENABLED=false

# Mobile Web Remote Settings
MOBILE_SERVER_PORT=8000
MOBILE_SERVER_HOST=0.0.0.0
