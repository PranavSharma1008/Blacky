[TEMPLATE]
# BlackyAgent Configuration Template
# Blacky runs entirely on a local Ollama model. No API key, no cloud LLM.
# Install Ollama: https://ollama.com  then: ollama pull qwen3:4b

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Optional local vision model for screen understanding (e.g. llava:7b, moondream).
# Leave empty to disable image analysis; nothing is downloaded automatically.
OLLAMA_VISION_MODEL=
OLLAMA_TIMEOUT=300
OLLAMA_KEEP_ALIVE=10m
OLLAMA_TEMPERATURE=0.2
OLLAMA_NUM_CTX=8192
# Let thinking-capable models reason first (slower, better on complex tasks).
OLLAMA_THINK=false
OLLAMA_HISTORY_MESSAGES=24
BLACKY_MAX_TOOL_HOPS=8

# Voice Settings
BLACKY_VOICE=Samantha
BLACKY_SPEECH_RATE=195
BLACKY_VOICE_ENABLED=false
BLACKY_VOICE_TRIGGER=option
# Show the transcript and let the user correct it before executing.
BLACKY_STT_CONFIRM=false

# Mobile Web Remote Settings
MOBILE_SERVER_PORT=8000
MOBILE_SERVER_HOST=0.0.0.0
# Required for remote (non-localhost) control. Also added to the pairing QR link.
MOBILE_API_TOKEN=
